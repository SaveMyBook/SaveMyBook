<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>救舊我的書</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>savemybook_app</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<!-- GIDClientID 與 Google 的反轉 client id 取自 Firebase 主控台下載的 GoogleService-Info.plist，
		     詳見 docs/social-login-setup.md；未替換佔位字串前 Google 登入會失敗。 -->
		<key>GIDClientID</key>
		<string>REPLACE_WITH_IOS_CLIENT_ID.apps.googleusercontent.com</string>
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLName</key>
				<string>com.savemybook.deeplink</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>savemybook</string>
				</array>
			</dict>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLName</key>
				<string>com.savemybook.googlesignin</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>com.googleusercontent.apps.REPLACE_WITH_IOS_CLIENT_ID</string>
				</array>
			</dict>
		</array>
		<key>NSUserActivityTypes</key>
		<array>
			<string>INSendMessageIntent</string>
		</array>
		<key>UIBackgroundModes</key>
		<array>
			<string>remote-notification</string>
		</array>
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UIStatusBarHidden</key>
		<false/>
		<key>NSCameraUsageDescription</key>
		<string>救「舊」我的書需要相機權限，以掃描書籍條碼與書櫃取書 QR Code，並拍攝書籍、大頭貼、聊天及爭議佐證照片。</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>救「舊」我的書需要相簿權限，以選取書籍照片、大頭貼、聊天圖片及爭議佐證照片。</string>
		<key>NSPhotoLibraryAddUsageDescription</key>
		<string>救「舊」我的書需要相簿寫入權限，以將您的個人檔案 QR Code 及聊天室中的圖片儲存至相簿。</string>
		<key>NSMicrophoneUsageDescription</key>
		<string>救「舊」我的書需要麥克風權限，以錄製並傳送聊天室語音訊息。</string>
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>救「舊」我的書僅在您使用 App 時取得位置，以顯示您與智慧書櫃的距離並依距離排序，不會在背景取得位置。</string>
		<key>NSLocationAlwaysUsageDescription</key>
		<string>救「舊」我的書僅在您使用 App 時取得位置，以顯示您與智慧書櫃的距離並依距離排序，不會在背景取得位置。</string>
		<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
		<string>救「舊」我的書僅在您使用 App 時取得位置，以顯示您與智慧書櫃的距離並依距離排序，不會在背景取得位置。</string>
		<key>NSFaceIDUsageDescription</key>
		<string>救「舊」我的書需要使用 Face ID，以便您快速登入、解鎖 App 及確認付款。</string>
	</dict>
</plist>
