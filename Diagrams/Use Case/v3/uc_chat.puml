@startuml
skinparam monochrome true
skinparam shadowing false
skinparam dpi 220
skinparam defaultFontName "PingFang TC"
skinparam defaultFontSize 13
skinparam usecase {
  BackgroundColor white
}
left to right direction

actor 會員
actor 管理員

rectangle "SaveMyBook - 聊天與社交" {
  usecase "傳送訊息" as send
  usecase "確認傳送聯絡方式\n或付款資訊" as confirm
  usecase "查看防詐提醒" as warn
  usecase "檢舉可疑訊息" as reportmsg
  usecase "@提及成員" as mention
  usecase "建立與管理群組" as group
  usecase "預約保留書籍" as reserve
  usecase "站內轉帳／請款" as transfer
  usecase "付款驗證" as verify
  usecase "封鎖／檢舉使用者" as block
  usecase "設定暱稱、靜音、置頂" as settings
  usecase "AI 問書" as aichat
  usecase "處理防詐警示" as alert
}

會員 --> send
會員 --> warn
會員 --> group
會員 --> reserve
會員 --> transfer
會員 --> block
會員 --> settings
會員 --> aichat
send <.. confirm : <<extend>>
send <.. mention : <<extend>>
transfer ..> verify : <<include>>
warn <.. reportmsg : <<extend>>
管理員 --> alert
@enduml
