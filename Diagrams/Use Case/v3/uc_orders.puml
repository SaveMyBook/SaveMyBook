@startuml
skinparam monochrome true
skinparam shadowing false
skinparam dpi 220
skinparam defaultFontName "PingFang TC"
skinparam defaultFontSize 13
skinparam usecase {
  BackgroundColor white
}
left to right direction

actor 買家
actor 賣家
actor 管理員

rectangle "SaveMyBook - 交易與訂單" {
  usecase "加入購物車" as cart
  usecase "結帳" as checkout
  usecase "直接購買" as buynow
  usecase "付款驗證" as verify
  usecase "查看購買紀錄" as history
  usecase "我要取書" as pickup
  usecase "掃描書櫃 QR Code" as scan
  usecase "完成訂單" as complete
  usecase "提出申訴" as dispute
  usecase "查看銷售紀錄" as sales
  usecase "我要存書" as deposit
  usecase "取消訂單" as cancel
  usecase "仲裁申訴" as arbitrate
}

買家 --> cart
買家 --> checkout
買家 --> buynow
買家 --> history
買家 --> pickup
買家 --> complete
買家 --> dispute
買家 --> cancel
checkout ..> verify : <<include>>
buynow ..> verify : <<include>>
pickup ..> scan : <<include>>
賣家 --> sales
賣家 --> deposit
賣家 --> cancel
賣家 --> dispute
deposit ..> scan : <<include>>
管理員 --> arbitrate
@enduml
