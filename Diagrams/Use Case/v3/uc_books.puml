@startuml
skinparam monochrome true
skinparam shadowing false
skinparam dpi 220
skinparam defaultFontName "PingFang TC"
skinparam defaultFontSize 13
skinparam usecase {
  BackgroundColor white
}
left to right direction

actor 賣家
actor 買家
actor "AI 服務" as AI

rectangle "SaveMyBook - 書籍與商品管理" {
  usecase "管理書籍" as manage
  usecase "我要賣書" as sell
  usecase "掃描 ISBN" as isbn
  usecase "AI 輔助上架" as assist
  usecase "上架審核" as review
  usecase "自動補齊書籍資料" as enrich
  usecase "編輯書籍" as edit
  usecase "下架／重新上架" as delist
  usecase "瀏覽與搜尋書籍" as browse
  usecase "查看書籍詳情" as detail
  usecase "查看相似的書" as similar
  usecase "查看個人化推薦" as recommend
  usecase "收藏書籍" as fav
  usecase "檢舉書籍" as report
}

賣家 --> manage
manage <.. sell : <<extend>>
manage <.. edit : <<extend>>
manage <.. delist : <<extend>>
sell <.. isbn : <<extend>>
sell <.. assist : <<extend>>
sell ..> review : <<include>>
sell ..> enrich : <<include>>
買家 --> browse
買家 --> recommend
買家 --> fav
買家 --> report
browse ..> detail : <<include>>
detail <.. similar : <<extend>>
assist -- AI
enrich -- AI
@enduml
