@startuml
skinparam monochrome true
skinparam shadowing false
skinparam dpi 220
skinparam defaultFontName "PingFang TC"
skinparam defaultFontSize 13
skinparam usecase {
  BackgroundColor white
}
skinparam nodesep 24
skinparam ranksep 100
left to right direction

actor 管理員
actor "AI 服務" as AI
actor "臺北市資料大平臺" as ODP

rectangle "SaveMyBook - 後台管理" {
  usecase "查看營運總覽" as overview
  usecase "管理會員與等級" as members
  usecase "管理書籍與分類" as books
  usecase "內容審核" as moderation
  usecase "上架審核" as review
  usecase "處理檢舉" as report
  usecase "處理防詐警示" as risk
  usecase "管理訂單" as orders
  usecase "裁決交易爭議" as dispute
  usecase "AI 分析爭議" as aianalysis
  usecase "管理智慧書櫃" as cabinets
  usecase "配對書櫃裝置" as pair
  usecase "遠端開啟櫃門" as remote
  usecase "處理待確認作業與櫃門" as cabreview
  usecase "確認手動回報" as cabmanual
  usecase "登記取出存書" as clear
  usecase "設定書櫃座標\n並預覽附近交通" as curloc
  usecase "管理公告與文件" as content
  usecase "處理客服工單" as tickets
  usecase "系統維運" as settings
  usecase "設定 AI 功能" as ai
  usecase "設定登入方式" as signin
  usecase "備份與還原資料庫" as backup
  usecase "查看操作紀錄與還原" as logs
}

管理員 --> overview
管理員 --> members
管理員 --> books
管理員 --> moderation
moderation <. "«extend»" review
report "«extend»" .> moderation
moderation <.. risk : <<extend>>
管理員 --> orders
管理員 --> dispute
dispute <.. aianalysis : <<extend>>
aianalysis -- AI
管理員 --> cabinets
cabinets <. "«extend»" pair
cabinets <.. remote : <<extend>>
cabinets <.. cabreview : <<extend>>
cabinets <.. cabmanual : <<extend>>
clear "«extend»" .> cabinets
管理員 --> curloc
curloc -- ODP
aianalysis -[hidden]- ODP
管理員 --> content
管理員 --> tickets
管理員 --> settings
settings <. "«extend»" ai
signin "«extend»" .> settings
settings <.. backup : <<extend>>
管理員 --> logs
@enduml
