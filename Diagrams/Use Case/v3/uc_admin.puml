@startuml
skinparam monochrome true
skinparam shadowing false
skinparam dpi 220
skinparam defaultFontName "PingFang TC"
skinparam defaultFontSize 13
skinparam usecase {
  BackgroundColor white
}
left to right direction

actor 管理員
actor "AI 服務" as AI

rectangle "SaveMyBook - 後台管理" {
  usecase "查看營運總覽" as overview
  usecase "管理會員與等級" as members
  usecase "管理書籍與分類" as books
  usecase "內容審核" as moderation
  usecase "上架審核" as review
  usecase "處理檢舉" as report
  usecase "處理防詐警示" as risk
  usecase "管理訂單" as orders
  usecase "仲裁申訴" as dispute
  usecase "AI 分析申訴" as aianalysis
  usecase "管理智慧書櫃" as cabinets
  usecase "管理公告與文件" as content
  usecase "處理客服工單" as tickets
  usecase "系統設定" as settings
  usecase "設定 AI 功能" as ai
  usecase "設定登入方式" as signin
  usecase "備份與還原資料庫" as backup
  usecase "查看操作紀錄與復原" as logs
}

管理員 --> overview
管理員 --> members
管理員 --> books
管理員 --> moderation
moderation <.. review : <<extend>>
moderation <.. report : <<extend>>
moderation <.. risk : <<extend>>
管理員 --> orders
管理員 --> dispute
dispute <.. aianalysis : <<extend>>
aianalysis -- AI
管理員 --> cabinets
管理員 --> content
管理員 --> tickets
管理員 --> settings
settings <.. ai : <<extend>>
settings <.. signin : <<extend>>
settings <.. backup : <<extend>>
管理員 --> logs
@enduml
