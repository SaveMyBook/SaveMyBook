@startuml
skinparam monochrome true
skinparam shadowing false
skinparam dpi 220
skinparam defaultFontName "PingFang TC"
skinparam defaultFontSize 13
skinparam usecase {
  BackgroundColor white
}
left to right direction

actor 訪客
actor 會員
actor "Google／Apple\nLINE／Discord" as Provider

rectangle "SaveMyBook - 帳號與安全" {
  usecase "註冊帳號" as reg
  usecase "登入" as login
  usecase "密碼登入" as pwd
  usecase "第三方登入" as social
  usecase "通行密鑰登入" as pk
  usecase "同意服務條款\n與隱私權政策" as legal
  usecase "管理個人資料" as profile
  usecase "管理登入方式" as methods
  usecase "設定交易密碼\n與生物辨識" as pin
  usecase "身分驗證" as verify
  usecase "管理登入裝置" as sessions
  usecase "匯出資料或\n申請刪除帳號" as delete
}

訪客 --> reg
訪客 --> login
會員 --> profile
會員 --> methods
會員 --> pin
會員 --> sessions
會員 --> delete
login <.. pwd : <<extend>>
login <.. social : <<extend>>
login <.. pk : <<extend>>
login ..> legal : <<include>>
methods ..> verify : <<include>>
pin ..> verify : <<include>>
delete ..> verify : <<include>>
social -- Provider
@enduml
