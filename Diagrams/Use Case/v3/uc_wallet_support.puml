@startuml
skinparam monochrome true
skinparam shadowing false
skinparam dpi 220
skinparam defaultFontName "PingFang TC"
skinparam defaultFontSize 13
skinparam usecase {
  BackgroundColor white
}
left to right direction

actor 會員
actor 管理員

rectangle "SaveMyBook - 錢包、會員與客服" {
  usecase "管理代幣" as wallet
  usecase "查看交易紀錄" as txn
  usecase "查看待撥款項" as pending
  usecase "查看會員等級與成就" as level
  usecase "查看常見問題" as faq
  usecase "AI 客服" as aisupport
  usecase "轉真人客服" as handoff
  usecase "建立客服工單" as ticket
  usecase "回覆與結案工單" as reply
  usecase "調整會員錢包" as adjust
  usecase "處理客服工單" as handle
}

會員 --> wallet
wallet <.. txn : <<extend>>
wallet <.. pending : <<extend>>
會員 --> level
會員 --> faq
會員 --> aisupport
會員 --> ticket
會員 --> reply
aisupport <.. handoff : <<extend>>
管理員 --> adjust
管理員 --> handle
@enduml
