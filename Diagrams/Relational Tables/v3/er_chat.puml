@startuml
!pragma layout smetana
skinparam defaultFontName "Microsoft JhengHei"
skinparam defaultFontSize 13
skinparam linetype ortho
hide circle
hide empty methods
skinparam ranksep 60
skinparam nodesep 40
skinparam class {
  BackgroundColor White
  BorderColor #444444
  ArrowColor #555555
}

title 聊天與社交模組 ER 圖

entity "chat_rooms\n聊天室表" as chat_rooms {
  * room_id : INT
  + user_a_id : INT
  + user_b_id : INT
  + book_id : INT
  - created_at : DATETIME
  - updated_at : DATETIME
  - room_type : ENUM
  - name : VARCHAR(50)
  - avatar_url : VARCHAR(500)
  - created_by : INT
}

entity "chat_messages\n聊天訊息表" as chat_messages {
  * message_id : INT
  + room_id : INT
  + sender_id : INT
  - content : TEXT
  - message_type : ENUM
  - is_read : TINYINT(1)
  - created_at : DATETIME
  - reply_to_id : INT
  - edited_at : DATETIME
  - mentions : TEXT
}

entity "chat_room_members\n聊天室成員表" as chat_room_members {
  * room_id : INT
  * user_id : INT
  - role : ENUM
  - joined_at : DATETIME
  - left_at : DATETIME
  - last_read_message_id : INT
  - history_from_id : INT
}

entity "chat_room_mutes\n聊天室靜音表" as chat_room_mutes {
  * user_id : INT
  * room_id : INT
  - created_at : DATETIME
}

entity "chat_room_pins\n聊天室置頂表" as chat_room_pins {
  * user_id : INT
  * room_id : INT
  - pinned_at : DATETIME
}

entity "chat_aliases\n聊天暱稱別名表" as chat_aliases {
  * owner_id : INT
  * target_user_id : INT
  - alias : VARCHAR(30)
  - updated_at : DATETIME
}

entity "chat_mentions\n聊天@提及紀錄表" as chat_mentions {
  * message_id : INT
  - room_id : INT
  * user_id : INT
}

entity "chat_transfers\n聊天室轉帳/請款表" as chat_transfers {
  * transfer_id : INT
  - room_id : INT
  - message_id : INT
  - kind : ENUM
  + from_user_id : INT
  + to_user_id : INT
  - amount : DECIMAL(12, 2)
  - note : VARCHAR(100)
  - status : ENUM
  - created_at : DATETIME
  - responded_at : DATETIME
  - expires_at : DATETIME
}

chat_rooms ||--o{ chat_messages : "room_id"
chat_rooms ||--o{ chat_room_members : "room_id"
chat_rooms ||--o{ chat_room_mutes : "room_id"
chat_rooms ||--o{ chat_room_pins : "room_id"
chat_messages ||--o{ chat_mentions : "message_id"
@enduml