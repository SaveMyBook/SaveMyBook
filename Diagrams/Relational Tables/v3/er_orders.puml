@startuml
skinparam monochrome true
skinparam shadowing false
skinparam dpi 220
skinparam defaultFontName "PingFang TC"
skinparam defaultFontSize 12
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 40
hide circle
hide empty methods
left to right direction

entity "orders" as orders {
  {field} <&key> order_id : int
  --
  {field} order_no : varchar(30)
  {field} buyer_id : int
  {field} seller_id : int
  {field} total_amount : decimal(10,2)
  {field} cabinet_id : int
  {field} slot_id : int
  {field} pickup_code : varchar(20)
  {field} pickup_qr_code : varchar(500)
  {field} status : enum
  {field} payment_method : enum
  {field} payment_at : datetime
  {field} deposited_at : datetime
  {field} picked_up_at : datetime
  {field} completed_at : datetime
  {field} cancelled_at : datetime
  {field} cancel_reason : text
  {field} note : text
  {field} created_at : datetime
  {field} updated_at : datetime
}
entity "order_items" as order_items {
  {field} <&key> item_id : int
  --
  {field} order_id : int
  {field} book_id : int
  {field} quantity : int
  {field} unit_price : decimal(10,2)
  {field} subtotal : decimal(10,2)
}
entity "smart_cabinets" as smart_cabinets {
  {field} <&key> cabinet_id : int
  --
  {field} cabinet_name : varchar(100)
  {field} address : varchar(500)
  {field} latitude : decimal(10,7)
  {field} longitude : decimal(10,7)
  {field} total_slots : int
  {field} available_slots : int
  {field} is_active : tinyint(1)
  {field} open_time : time
  {field} close_time : time
  {field} is_maintenance : tinyint(1)
  {field} created_at : datetime
  {field} updated_at : datetime
}
entity "cabinet_slots" as cabinet_slots {
  {field} <&key> slot_id : int
  --
  {field} cabinet_id : int
  {field} slot_number : varchar(10)
  {field} status : enum
  {field} current_book_id : int
  {field} current_order_id : int
  {field} updated_at : datetime
}
entity "reservations" as reservations {
  {field} <&key> reservation_id : int
  --
  {field} book_id : int
  {field} buyer_id : int
  {field} seller_id : int
  {field} cabinet_id : int
  {field} status : enum
  {field} pickup_deadline : datetime
  {field} qr_code : varchar(500)
  {field} note : text
  {field} created_at : datetime
  {field} updated_at : datetime
}
entity "transaction_disputes" as transaction_disputes {
  {field} <&key> dispute_id : int
  --
  {field} order_id : int
  {field} applicant_id : int
  {field} reason : text
  {field} evidence_urls : text
  {field} status : enum
  {field} admin_id : int
  {field} admin_note : text
  {field} result : enum
  {field} created_at : datetime
  {field} resolved_at : datetime
}
entity "refund_records" as refund_records {
  {field} <&key> refund_id : int
  --
  {field} order_id : int
  {field} dispute_id : int
  {field} refund_type : enum
  {field} amount : decimal(10,2)
  {field} status : enum
  {field} admin_id : int
  {field} reason : text
  {field} created_at : datetime
  {field} processed_at : datetime
}
smart_cabinets ||--o{ orders
cabinet_slots ||--o{ orders
orders ||--o{ order_items
smart_cabinets ||--o{ cabinet_slots
smart_cabinets ||--o{ reservations
orders ||--o{ transaction_disputes
transaction_disputes ||--o{ refund_records
orders ||--o{ refund_records
@enduml
