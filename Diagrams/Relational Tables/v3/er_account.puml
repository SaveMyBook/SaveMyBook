@startuml
skinparam monochrome true
skinparam shadowing false
skinparam dpi 220
skinparam defaultFontName "PingFang TC"
skinparam defaultFontSize 12
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 40
hide circle
hide empty methods

entity "users" as users {
  {field} <&key> user_id : int
  --
  {field} email : varchar(255)
  {field} password_hash : varchar(255)
  {field} nickname : varchar(50)
  {field} avatar_url : varchar(500)
  {field} bio : text
  {field} phone : varchar(20)
  {field} birthday : date
  {field} gender : enum
  {field} role : enum
  {field} is_active : tinyint(1)
  {field} is_blacklisted : tinyint(1)
  {field} created_at : datetime
  {field} updated_at : datetime
  {field} bonus_points : int
  {field} deletion_requested_at : datetime
  {field} anonymized_at : datetime
  {field} share_token : char(32)
  {field} password_set : tinyint(1)
}
entity "user_sessions" as user_sessions {
  {field} <&key> session_id : int
  --
  {field} user_id : int
  {field} sid : char(32)
  {field} device_id : varchar(64)
  {field} device_name : varchar(100)
  {field} platform : varchar(20)
  {field} app_version : varchar(20)
  {field} ip_address : varchar(45)
  {field} pay_key_hash : char(64)
  {field} created_at : datetime
  {field} last_seen_at : datetime
  {field} revoked_at : datetime
}
entity "login_logs" as login_logs {
  {field} <&key> log_id : int
  --
  {field} user_id : int
  {field} login_at : datetime
  {field} ip_address : varchar(45)
  {field} device_info : varchar(255)
  {field} login_method : varchar(20)
}
entity "push_devices" as push_devices {
  {field} <&key> device_id : int
  --
  {field} user_id : int
  {field} token : varchar(255)
  {field} platform : enum
  {field} app_version : varchar(20)
  {field} created_at : datetime
  {field} last_seen_at : datetime
  {field} session_sid : char(32)
}
users ||--o{ user_sessions
users ||--o{ login_logs
users ||--o{ push_devices
@enduml
