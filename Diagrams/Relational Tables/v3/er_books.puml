@startuml
skinparam monochrome true
skinparam shadowing false
skinparam dpi 220
skinparam defaultFontName "PingFang TC"
skinparam defaultFontSize 12
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 40
hide circle
hide empty methods

entity "books" as books {
  {field} <&key> book_id : int
  --
  {field} seller_id : int
  {field} isbn : varchar(13)
  {field} title : varchar(255)
  {field} author : varchar(255)
  {field} publisher : varchar(255)
  {field} publish_date : varchar(20)
  {field} category_id : int
  {field} condition_level : enum
  {field} condition_note : text
  {field} price : decimal(10,2)
  {field} quantity : int
  {field} description : text
  {field} cabinet_id : int
  {field} status : enum
  {field} view_count : int
  {field} is_approved : tinyint(1)
  {field} share_token : char(32)
  {field} created_at : datetime
  {field} updated_at : datetime
}
entity "book_categories" as book_categories {
  {field} <&key> category_id : int
  --
  {field} category_name : varchar(50)
  {field} parent_id : int
  {field} sort_order : int
  {field} created_at : datetime
}
entity "book_images" as book_images {
  {field} <&key> image_id : int
  --
  {field} book_id : int
  {field} image_url : varchar(500)
  {field} image_type : enum
  {field} sort_order : int
  {field} created_at : datetime
}
entity "favorites" as favorites {
  {field} <&key> favorite_id : int
  --
  {field} user_id : int
  {field} book_id : int
  {field} created_at : datetime
}
entity "shopping_cart" as shopping_cart {
  {field} <&key> cart_id : int
  --
  {field} user_id : int
  {field} book_id : int
  {field} quantity : int
  {field} added_at : datetime
}
entity "recommendation_logs" as recommendation_logs {
  {field} <&key> rec_id : int
  --
  {field} user_id : int
  {field} book_id : int
  {field} rec_type : enum
  {field} is_clicked : tinyint(1)
  {field} created_at : datetime
}
entity "reports" as reports {
  {field} <&key> report_id : int
  --
  {field} reporter_id : int
  {field} target_type : enum
  {field} target_id : int
  {field} reason : text
  {field} evidence_urls : text
  {field} status : enum
  {field} admin_id : int
  {field} admin_note : text
  {field} created_at : datetime
  {field} resolved_at : datetime
}
entity "content_reviews" as content_reviews {
  {field} <&key> review_id : int
  --
  {field} content_type : enum
  {field} content_id : int
  {field} status : enum
  {field} admin_id : int
  {field} review_note : text
  {field} created_at : datetime
  {field} reviewed_at : datetime
}
entity "ai_book_reviews" as ai_book_reviews {
  {field} <&key> book_id : int
  --
  {field} verdict : varchar(10)
  {field} reasons : text
  {field} categories : text
  {field} status : enum
  {field} provider : varchar(20)
  {field} model : varchar(80)
  {field} created_at : datetime
  {field} reviewed_by : int
  {field} reviewed_at : datetime
}
entity "ai_book_enrichments" as ai_book_enrichments {
  {field} <&key> book_id : int
  --
  {field} status : varchar(10)
  {field} fields : varchar(200)
  {field} ai_written : tinyint(1)
  {field} attempted_at : datetime
}
book_categories ||--o{ books
book_categories ||--o{ book_categories
books ||--o{ book_images
books ||--o{ favorites
books ||--o{ shopping_cart
books ||--o{ recommendation_logs
books ||--o| ai_book_reviews
books ||--o| ai_book_enrichments
book_images -[hidden]down- ai_book_reviews
favorites -[hidden]down- ai_book_enrichments
@enduml
