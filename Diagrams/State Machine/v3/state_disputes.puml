@startuml
skinparam monochrome true
skinparam shadowing false
skinparam dpi 220
skinparam defaultFontName "PingFang TC"
skinparam defaultFontSize 13
hide empty description

[*] --> 待處理 : 買家或賣家提出申訴
待處理 --> 已結案 : 管理員裁決

state 已結案 {
  [*] --> 退款 : 判定退款
  [*] --> 駁回 : 判定駁回
  [*] --> 調解 : 協調結案
}
已結案 --> [*]
@enduml
