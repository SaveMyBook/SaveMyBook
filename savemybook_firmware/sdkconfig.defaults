CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_ESP_TASK_WDT_PANIC=y
# 效能：-O2、CPU 240 MHz（書櫃為市電供電，不需省電）。
# 開機階段的系統紀錄只印警告，序列埠逐字輸出共少等約 0.2 秒；app_main 一開始把紀錄調回 Info，本專案的紀錄照常輸出
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y
# 連線：DHCP 沿用上次的 IP（路由器不同意時自動改走完整流程），並略過取得 IP 後約 0.5–1 秒的 ARP 衝突檢查
CONFIG_LWIP_DHCP_RESTORE_LAST_IP=y
CONFIG_LWIP_DHCP_DOES_NOT_CHECK_OFFERED_IP=y
# 橢圓曲線固定點乘法查表（韌體多約 29 KB）：伺服器憑證為 ECDSA，HTTPS 握手與 WPA3 連線的運算快 3–4 倍
CONFIG_MBEDTLS_ECP_FIXED_POINT_OPTIM=y
# 螢幕：自製主控板 SPI 80 MHz；FreeRTOS 1 ms 刻度，動畫才能穩定排在 60 fps
CONFIG_SMB_TFT_SPI_MHZ=80
CONFIG_FREERTOS_HZ=1000
# 模組內建 8 MB 八線 PSRAM（ESP32-S3R8）：放畫面快取
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
