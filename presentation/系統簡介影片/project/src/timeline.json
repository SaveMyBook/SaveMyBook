 "lines": [
  {
   "id": "01",
   "sec": "open",
   "at": 0.8,
   "dur": 4.54,
   "text": "二手書交易，最怕面交被放鳥，寄送又麻煩。"
  },
  {
   "id": "02",
   "sec": "open",
   "at": 5.66,
   "dur": 6.91,
   "text": "問卷中，57.4% 的人認為，書櫃最吸引人的是「24 小時自助」。"
  },
  {
   "id": "03",
   "sec": "open",
   "at": 12.89,
   "dur": 5.8,
   "text": "救「舊」我的書，結合 App 與智慧書櫃，買賣雙方不必約時間見面。"
  },
  {
   "id": "04",
   "sec": "overview",
   "at": 0.95,
   "dur": 6.47,
   "text": "線上看書況、付款，賣家存書、買家取書，驗收後才撥款。"
  },
  {
   "id": "05",
   "sec": "list",
   "at": 0.95,
   "dur": 5.62,
   "text": "賣家掃描 ISBN，系統自動帶出書名、作者與出版社。"
  },
  {
   "id": "06",
   "sec": "list",
   "at": 6.89,
   "dur": 5.12,
   "text": "拍下書況照片，AI 判斷書況，並建議售價區間。"
  },
  {
   "id": "07",
   "sec": "list",
   "at": 12.33,
   "dur": 4.94,
   "text": "上架內容再經規則與 AI 雙層審核，把關品質。"
  },
  {
   "id": "08",
   "sec": "find",
   "at": 0.95,
   "dur": 6.07,
   "text": "買家可以用書名、作者或 ISBN 搜尋，也會收到個人化推薦。"
  },
  {
   "id": "09",
   "sec": "find",
   "at": 7.34,
   "dur": 4.28,
   "text": "說出需求與預算，AI 書籍顧問幫你挑書。"
  },
  {
   "id": "10",
   "sec": "find",
   "at": 11.94,
   "dur": 6.94,
   "text": "聊天室支援文字、圖片與語音，出現高風險訊息時，會即時提醒防詐。"
  },
  {
   "id": "11",
   "sec": "pay",
   "at": 0.95,
   "dur": 5.27,
   "text": "付款以交易密碼或生物辨識驗證，款項先由平台暫管。"
  },
  {
   "id": "12",
   "sec": "cabinet",
   "at": 0.95,
   "dur": 6.75,
   "text": "智慧書櫃以一片 ESP32-S3，控制四扇電磁鎖櫃門與螢幕。"
  },
  {
   "id": "13",
   "sec": "cabinet",
   "at": 8.02,
   "dur": 5.93,
   "text": "開櫃前，必須在書櫃 200 公尺內，掃描每 30 秒更新的 QR Code，"
  },
  {
   "id": "14",
   "sec": "cabinet",
   "at": 14.27,
   "dur": 5.62,
   "text": "再於 60 秒內輸入螢幕上的兩位數字，指定的櫃門才會開啟。"
  },
  {
   "id": "15",
   "sec": "cabinet",
   "at": 20.21,
   "dur": 4.21,
   "text": "關上櫃門，系統登記存書，並通知買家。"
  },
  {
   "id": "16",
   "sec": "cabinet",
   "at": 24.74,
   "dur": 6.5,
   "text": "App 也整合臺北市開放資料，提供前往書櫃的捷運、公車與 YouBike 資訊。"
  },
  {
   "id": "17",
   "sec": "after",
   "at": 0.95,
   "dur": 8.45,
   "text": "買家用同樣的方式取書，當場檢查書況；滿 24 小時沒有爭議，款項自動撥給賣家。"
  },
  {
   "id": "18",
   "sec": "after",
   "at": 9.72,
   "dur": 7.33,
   "text": "書況不符，可以附上照片申請爭議，AI 比對上架資料，協助管理員處理。"
  },
  {
   "id": "19",
   "sec": "after",
   "at": 17.37,
   "dur": 5.52,
   "text": "使用上的問題，AI 客服即時回答，也能一鍵轉接真人。"
  },
  {
   "id": "19b",
   "sec": "after",
   "at": 23.21,
   "dur": 4.93,
   "text": "從上架、選書到售後，七項 AI 服務全程協助。"
  },
  {
   "id": "20",
   "sec": "account",
   "at": 0.95,
   "dur": 5.98,
   "text": "登入支援 Google、Apple、LINE、手機簡訊與通行密鑰等多種方式。"
  },
  {
   "id": "21",
   "sec": "account",
   "at": 7.25,
   "dur": 6.91,
   "text": "完成交易可以累積點數、升級會員，介面支援五種語言與深淺色主題。"
  },
  {
   "id": "22",
   "sec": "admin",
   "at": 0.95,
   "dur": 6.29,
   "text": "管理後台整合在 App 中，可以處理上架審核、訂單、爭議與公告；"
  },
  {
   "id": "23",
   "sec": "admin",
   "at": 7.56,
   "dur": 4.87,
   "text": "輸入書櫃螢幕上的八位數配對碼，就能連線新書櫃。"
  },
  {
   "id": "24",
   "sec": "tech",
   "at": 0.95,
   "dur": 6.03,
   "text": "系統以 Flutter、Node.js、MariaDB 與 ESP32-S3 打造，"
  },
  {
   "id": "24b",
   "sec": "tech",
   "at": 7.3,
   "dur": 6.1,
   "text": "共 301 個 API，前後端超過四千項自動化測試全數通過。"
  },
  {
   "id": "25",
   "sec": "end",
   "at": 0.95,
   "dur": 4.57,
   "text": "救「舊」我的書，讓閒置的書，在校園裡重新流動。"
  }
 ]
}