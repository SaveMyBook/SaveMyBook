generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model achievements {
  achievement_id    Int                 @id @default(autoincrement()) @db.UnsignedInt
  achievement_name  String              @db.VarChar(100)
  description       String?             @db.Text
  icon_url          String?             @db.VarChar(500)
  condition_type    String              @db.VarChar(50)
  condition_value   Int
  created_at        DateTime            @default(now()) @db.DateTime(0)
  user_achievements user_achievements[]
}

model admin_operation_logs {
  log_id      Int      @id @default(autoincrement()) @db.UnsignedInt
  admin_id    Int      @db.UnsignedInt
  action      String   @db.VarChar(100)
  target_type String?  @db.VarChar(50)
  target_id   Int?     @db.UnsignedInt
  detail      String?  @db.Text
  ip_address  String?  @db.VarChar(45)
  created_at  DateTime @default(now()) @db.DateTime(0)
  users       users    @relation(fields: [admin_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_oplog_admin")

  @@index([admin_id, created_at], map: "idx_admin_time")
}

model admin_permissions {
  admin_perm_id            Int      @id @default(autoincrement()) @db.UnsignedInt
  user_id                  Int      @unique(map: "uk_admin_user") @db.UnsignedInt
  can_manage_transactions  Boolean  @default(true)
  can_manage_members       Boolean  @default(true)
  can_manage_content       Boolean  @default(true)
  can_manage_reports       Boolean  @default(true)
  can_manage_announcements Boolean  @default(true)
  can_manage_cabinets      Boolean  @default(true)
  created_at               DateTime @default(now()) @db.DateTime(0)
  can_manage_orders        Boolean  @default(true)
  can_manage_wallets       Boolean  @default(true)
  can_manage_levels        Boolean  @default(true)
  can_view_stats           Boolean  @default(true)
  can_manage_support       Boolean  @default(true)
  can_manage_system        Boolean  @default(false)
  users                    users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_admin_user")
}

model bankbooks {
  bankbook_id    Int      @id @default(autoincrement()) @db.UnsignedInt
  user_id        Int      @db.UnsignedInt
  bank_name      String?  @db.VarChar(100)
  account_number String?  @db.VarChar(30)
  qr_code_url    String?  @db.VarChar(500)
  is_verified    Boolean  @default(false)
  created_at     DateTime @default(now()) @db.DateTime(0)
  updated_at     DateTime @default(now()) @db.DateTime(0)
  users          users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_bankbook_user")

  @@index([user_id], map: "idx_user")
}

model book_categories {
  category_id           Int               @id @default(autoincrement()) @db.UnsignedInt
  category_name         String            @db.VarChar(50)
  parent_id             Int?              @db.UnsignedInt
  sort_order            Int               @default(0)
  created_at            DateTime          @default(now()) @db.DateTime(0)
  book_categories       book_categories?  @relation("book_categoriesTobook_categories", fields: [parent_id], references: [category_id], onUpdate: NoAction, map: "fk_category_parent")
  other_book_categories book_categories[] @relation("book_categoriesTobook_categories")
  books                 books[]

  @@index([parent_id], map: "idx_parent")
}

model book_images {
  image_id   Int                    @id @default(autoincrement()) @db.UnsignedInt
  book_id    Int                    @db.UnsignedInt
  image_url  String                 @db.VarChar(500)
  image_type book_images_image_type @default(other)
  sort_order Int                    @default(0)
  created_at DateTime               @default(now()) @db.DateTime(0)
  books      books                  @relation(fields: [book_id], references: [book_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_image_book")

  @@index([book_id], map: "idx_book_images")
}

model books {
  book_id                   Int                         @id @default(autoincrement()) @db.UnsignedInt
  seller_id                 Int                         @db.UnsignedInt
  isbn                      String?                     @db.VarChar(13)
  title                     String                      @db.VarChar(255)
  author                    String?                     @db.VarChar(255)
  publisher                 String?                     @db.VarChar(255)
  publish_date              String?                     @db.VarChar(20)
  category_id               Int?                        @db.UnsignedInt
  condition_level           books_condition_level       @default(good)
  condition_note            String?                     @db.Text
  price                     Decimal                     @db.Decimal(10, 2)
  quantity                  Int                         @default(1) @db.UnsignedInt
  description               String?                     @db.Text
  cabinet_id                Int?                        @db.UnsignedInt
  status                    books_status                @default(on_sale)
  view_count                Int                         @default(0) @db.UnsignedInt
  is_approved               Boolean                     @default(true)
  share_token               String?                     @unique(map: "uk_book_share_token") @db.Char(32)
  created_at                DateTime                    @default(now()) @db.DateTime(0)
  updated_at                DateTime                    @default(now()) @db.DateTime(0)
  ai_book_reviews           ai_book_reviews?
  ai_review_events          ai_review_events[]
  ai_book_enrichments       ai_book_enrichments?
  book_deposits             book_deposits?
  cabinet_slot_items        cabinet_slot_items?
  cabinet_session_items     cabinet_session_items[]
  cabinet_manual_reports    cabinet_manual_reports[]
  book_images               book_images[]
  smart_cabinets            smart_cabinets?             @relation(fields: [cabinet_id], references: [cabinet_id], onUpdate: NoAction, map: "fk_book_cabinet")
  book_categories           book_categories?            @relation(fields: [category_id], references: [category_id], onUpdate: NoAction, map: "fk_book_category")
  users                     users                       @relation(fields: [seller_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_book_seller")
  chat_rooms                chat_rooms[]
  favorites                 favorites[]
  order_items               order_items[]
  recommendation_logs       recommendation_logs[]
  recommendation_dismissals recommendation_dismissals[]
  reservations              reservations[]
  shopping_cart             shopping_cart[]

  @@index([cabinet_id], map: "idx_cabinet")
  @@index([category_id], map: "idx_category")
  @@index([created_at], map: "idx_created")
  @@index([isbn], map: "idx_isbn")
  @@index([seller_id], map: "idx_seller")
  @@index([status], map: "idx_status")
  @@fulltext([title, author, publisher, description], map: "ft_book_search")
}

model cabinet_slots {
  slot_id               Int                     @id @default(autoincrement()) @db.UnsignedInt
  cabinet_id            Int                     @db.UnsignedInt
  slot_number           String                  @db.VarChar(10)
  status                cabinet_slots_status    @default(empty)
  current_book_id       Int?                    @db.UnsignedInt
  current_order_id      Int?                    @db.UnsignedInt
  updated_at            DateTime                @default(now()) @db.DateTime(0)
  lock_channel          Int?                    @db.UnsignedTinyInt
  fault_code            String?                 @db.VarChar(40)
  // 待確認櫃門：門內實際內容可能與紀錄不符；與硬體故障 fault_code 分開，裝置的 fault_cleared 不會清除它。
  check_required_at     DateTime?               @db.DateTime(0)
  check_session_id      Int?                    @db.UnsignedInt
  check_reason          String?                 @db.VarChar(40)
  // 門磁感測器最近一次回報的狀態（open／closed）；沒有門磁的裝置維持 NULL，伺服器不依此判斷任何流程。
  sensor_state          String?                 @db.VarChar(10)
  sensor_at             DateTime?               @db.DateTime(3)
  smart_cabinets        smart_cabinets          @relation(fields: [cabinet_id], references: [cabinet_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_slot_cabinet")
  orders                orders[]
  cabinet_slot_items    cabinet_slot_items[]
  cabinet_session_items cabinet_session_items[]
  cabinet_session_doors cabinet_session_doors[]

  @@unique([cabinet_id, slot_number], map: "uk_cabinet_slot")
  @@unique([cabinet_id, lock_channel], map: "uk_slot_channel")
  @@index([status], map: "idx_status")
}

model chat_messages {
  message_id         Int                        @id @default(autoincrement()) @db.UnsignedInt
  room_id            Int                        @db.UnsignedInt
  sender_id          Int                        @db.UnsignedInt
  content            String                     @db.Text
  message_type       chat_messages_message_type @default(text)
  is_read            Boolean                    @default(false)
  created_at         DateTime                   @default(now()) @db.DateTime(0)
  reply_to_id        Int?                       @db.UnsignedInt
  edited_at          DateTime?                  @db.DateTime(0)
  mentions           String?                    @db.Text
  chat_mentions      chat_mentions[]
  chat_message_risks chat_message_risks?
  chat_rooms         chat_rooms                 @relation(fields: [room_id], references: [room_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_msg_room")
  users              users                      @relation(fields: [sender_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_msg_sender")

  @@index([sender_id], map: "fk_msg_sender")
  @@index([room_id, created_at], map: "idx_room_time")
  @@index([reply_to_id], map: "idx_msg_reply")
}

model chat_rooms {
  room_id                           Int                  @id @default(autoincrement()) @db.UnsignedInt
  user_a_id                         Int                  @db.UnsignedInt
  user_b_id                         Int                  @db.UnsignedInt
  book_id                           Int?                 @db.UnsignedInt
  created_at                        DateTime             @default(now()) @db.DateTime(0)
  updated_at                        DateTime             @default(now()) @db.DateTime(0)
  room_type                         chat_rooms_room_type @default(direct)
  name                              String?              @db.VarChar(50)
  avatar_url                        String?              @db.VarChar(500)
  created_by                        Int?                 @db.UnsignedInt
  chat_messages                     chat_messages[]
  chat_room_members                 chat_room_members[]
  chat_room_mutes                   chat_room_mutes[]
  chat_room_pins                    chat_room_pins[]
  books                             books?               @relation(fields: [book_id], references: [book_id], onUpdate: NoAction, map: "fk_chat_book")
  users_chat_rooms_user_a_idTousers users                @relation("chat_rooms_user_a_idTousers", fields: [user_a_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_chat_user_a")
  users_chat_rooms_user_b_idTousers users                @relation("chat_rooms_user_b_idTousers", fields: [user_b_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_chat_user_b")

  @@unique([user_a_id, user_b_id, book_id], map: "uk_chat_pair")
  @@index([book_id], map: "fk_chat_book")
  @@index([user_b_id], map: "fk_chat_user_b")
}

model content_reviews {
  review_id    Int                          @id @default(autoincrement()) @db.UnsignedInt
  content_type content_reviews_content_type
  content_id   Int                          @db.UnsignedInt
  status       content_reviews_status       @default(pending)
  admin_id     Int?                         @db.UnsignedInt
  review_note  String?                      @db.Text
  created_at   DateTime                     @default(now()) @db.DateTime(0)
  reviewed_at  DateTime?                    @db.DateTime(0)
  users        users?                       @relation(fields: [admin_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_content_admin")

  @@index([admin_id], map: "fk_content_admin")
  @@index([status, content_type], map: "idx_status_type")
}

model favorites {
  favorite_id Int      @id @default(autoincrement()) @db.UnsignedInt
  user_id     Int      @db.UnsignedInt
  book_id     Int      @db.UnsignedInt
  created_at  DateTime @default(now()) @db.DateTime(0)
  books       books    @relation(fields: [book_id], references: [book_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_fav_book")
  users       users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_fav_user")

  @@unique([user_id, book_id], map: "uk_user_book")
  @@index([book_id], map: "fk_fav_book")
}

model login_logs {
  log_id       Int      @id @default(autoincrement()) @db.UnsignedInt
  user_id      Int      @db.UnsignedInt
  login_at     DateTime @default(now()) @db.DateTime(0)
  ip_address   String?  @db.VarChar(45)
  device_info  String?  @db.VarChar(255)
  login_method String?  @db.VarChar(20)
  users        users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_login_user")

  @@index([user_id, login_at], map: "idx_user_login")
}

model member_levels {
  level_id   Int     @id @default(autoincrement()) @db.UnsignedInt
  level_name String  @db.VarChar(50)
  min_points Int
  max_points Int?
  benefits   String? @db.Text
}

model notifications {
  notification_id Int                @id @default(autoincrement()) @db.UnsignedInt
  user_id         Int                @db.UnsignedInt
  type            notifications_type
  title           String             @db.VarChar(255)
  content         String             @db.Text
  related_id      Int?               @db.UnsignedInt
  related_type    String?            @db.VarChar(50)
  is_read         Boolean            @default(false)
  created_at      DateTime           @default(now()) @db.DateTime(0)
  pushed_at       DateTime?          @db.DateTime(0)
  actor_id        Int?               @db.UnsignedInt
  users           users              @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_notif_user")

  @@index([user_id, is_read], map: "idx_user_read")
  @@index([user_id, created_at], map: "idx_user_time")
  @@index([pushed_at, notification_id], map: "idx_notification_push_queue")
}

model order_items {
  item_id       Int     @id @default(autoincrement()) @db.UnsignedInt
  order_id      Int     @db.UnsignedInt
  book_id       Int     @db.UnsignedInt
  quantity      Int     @default(1) @db.UnsignedInt
  unit_price    Decimal @db.Decimal(10, 2)
  subtotal      Decimal @db.Decimal(10, 2)
  pre_deposited Boolean @default(false)
  books         books   @relation(fields: [book_id], references: [book_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_item_book")
  orders        orders  @relation(fields: [order_id], references: [order_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_item_order")

  @@index([book_id], map: "idx_book")
  @@index([order_id], map: "idx_order")
}

model orders {
  order_id                      Int                      @id @default(autoincrement()) @db.UnsignedInt
  order_no                      String                   @unique(map: "uk_order_no") @db.VarChar(30)
  buyer_id                      Int                      @db.UnsignedInt
  seller_id                     Int                      @db.UnsignedInt
  total_amount                  Decimal                  @db.Decimal(10, 2)
  cabinet_id                    Int?                     @db.UnsignedInt
  slot_id                       Int?                     @db.UnsignedInt
  pickup_code                   String?                  @db.VarChar(20)
  pickup_qr_code                String?                  @db.VarChar(500)
  status                        orders_status            @default(pending_payment)
  payment_method                orders_payment_method?
  payment_at                    DateTime?                @db.DateTime(0)
  deposited_at                  DateTime?                @db.DateTime(0)
  picked_up_at                  DateTime?                @db.DateTime(0)
  completed_at                  DateTime?                @db.DateTime(0)
  cancelled_at                  DateTime?                @db.DateTime(0)
  cancel_reason                 String?                  @db.Text
  note                          String?                  @db.Text
  created_at                    DateTime                 @default(now()) @db.DateTime(0)
  updated_at                    DateTime                 @default(now()) @db.DateTime(0)
  order_items                   order_items[]
  users_orders_buyer_idTousers  users                    @relation("orders_buyer_idTousers", fields: [buyer_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_order_buyer")
  smart_cabinets                smart_cabinets?          @relation(fields: [cabinet_id], references: [cabinet_id], onUpdate: NoAction, map: "fk_order_cabinet")
  users_orders_seller_idTousers users                    @relation("orders_seller_idTousers", fields: [seller_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_order_seller")
  cabinet_slots                 cabinet_slots?           @relation(fields: [slot_id], references: [slot_id], onUpdate: NoAction, map: "fk_order_slot")
  refund_records                refund_records[]
  transaction_disputes          transaction_disputes[]
  wallet_transactions           wallet_transactions[]
  cabinet_session_items         cabinet_session_items[]
  cabinet_manual_reports        cabinet_manual_reports[]

  @@index([slot_id], map: "fk_order_slot")
  @@index([buyer_id], map: "idx_buyer")
  @@index([cabinet_id], map: "idx_cabinet")
  @@index([created_at], map: "idx_created")
  @@index([seller_id], map: "idx_seller")
  @@index([status], map: "idx_status")
}

/// 推薦書籍的曝光紀錄：同一本書在同一來源的推薦中，每 6 小時只記一次。source 為 ai（AI 推薦）或 rules（規則式推薦）。
/// 保存 90 日，並納入個資匯出與刪除。
model recommendation_logs {
  rec_id     Int                          @id @default(autoincrement()) @db.UnsignedInt
  user_id    Int                          @db.UnsignedInt
  book_id    Int                          @db.UnsignedInt
  rec_type   recommendation_logs_rec_type
  source     String                       @default("rules") @db.VarChar(10)
  is_clicked Boolean                      @default(false)
  clicked_at DateTime?                    @db.DateTime(0)
  created_at DateTime                     @default(now()) @db.DateTime(0)
  books      books                        @relation(fields: [book_id], references: [book_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_rec_book")
  users      users                        @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_rec_user")

  @@index([book_id], map: "fk_rec_book")
  @@index([rec_type, created_at], map: "idx_type_time")
  @@index([user_id], map: "idx_user")
  @@index([user_id, book_id, created_at], map: "idx_rec_user_book")
}

/// 使用者對推薦書籍標示「不感興趣」，之後的推薦排除這些書。
model recommendation_dismissals {
  user_id    Int      @db.UnsignedInt
  book_id    Int      @db.UnsignedInt
  created_at DateTime @db.DateTime(0)
  users      users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_rec_dismiss_user")
  books      books    @relation(fields: [book_id], references: [book_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_rec_dismiss_book")

  @@id([user_id, book_id])
  @@index([book_id], map: "fk_rec_dismiss_book")
}

model referral_records {
  referral_id                              Int                     @id @default(autoincrement()) @db.UnsignedInt
  inviter_id                               Int                     @db.UnsignedInt
  invitee_id                               Int                     @db.UnsignedInt
  reward_amount                            Decimal                 @default(0.00) @db.Decimal(10, 2)
  status                                   referral_records_status @default(pending)
  created_at                               DateTime                @default(now()) @db.DateTime(0)
  users_referral_records_invitee_idTousers users                   @relation("referral_records_invitee_idTousers", fields: [invitee_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ref_invitee")
  users_referral_records_inviter_idTousers users                   @relation("referral_records_inviter_idTousers", fields: [inviter_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ref_inviter")

  @@index([invitee_id], map: "fk_ref_invitee")
  @@index([inviter_id], map: "idx_inviter")
}

model refund_records {
  refund_id            Int                        @id @default(autoincrement()) @db.UnsignedInt
  order_id             Int                        @db.UnsignedInt
  dispute_id           Int?                       @db.UnsignedInt
  refund_type          refund_records_refund_type
  amount               Decimal                    @db.Decimal(10, 2)
  status               refund_records_status      @default(pending)
  admin_id             Int?                       @db.UnsignedInt
  reason               String?                    @db.Text
  created_at           DateTime                   @default(now()) @db.DateTime(0)
  processed_at         DateTime?                  @db.DateTime(0)
  users                users?                     @relation(fields: [admin_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_refund_admin")
  transaction_disputes transaction_disputes?      @relation(fields: [dispute_id], references: [dispute_id], onUpdate: NoAction, map: "fk_refund_dispute")
  orders               orders                     @relation(fields: [order_id], references: [order_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_refund_order")

  @@index([admin_id], map: "fk_refund_admin")
  @@index([dispute_id], map: "fk_refund_dispute")
  @@index([order_id], map: "idx_order")
}

model reports {
  report_id                        Int                 @id @default(autoincrement()) @db.UnsignedInt
  reporter_id                      Int                 @db.UnsignedInt
  target_type                      reports_target_type
  target_id                        Int                 @db.UnsignedInt
  reason                           String              @db.Text
  evidence_urls                    String?             @db.Text
  status                           reports_status      @default(pending)
  admin_id                         Int?                @db.UnsignedInt
  admin_note                       String?             @db.Text
  created_at                       DateTime            @default(now()) @db.DateTime(0)
  resolved_at                      DateTime?           @db.DateTime(0)
  users_reports_admin_idTousers    users?              @relation("reports_admin_idTousers", fields: [admin_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_report_admin")
  users_reports_reporter_idTousers users               @relation("reports_reporter_idTousers", fields: [reporter_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_report_reporter")

  @@index([admin_id], map: "fk_report_admin")
  @@index([reporter_id], map: "fk_report_reporter")
  @@index([status], map: "idx_status")
  @@index([target_type, target_id], map: "idx_target")
}

model reservations {
  reservation_id                      Int                 @id @default(autoincrement()) @db.UnsignedInt
  book_id                             Int                 @db.UnsignedInt
  buyer_id                            Int                 @db.UnsignedInt
  seller_id                           Int                 @db.UnsignedInt
  cabinet_id                          Int?                @db.UnsignedInt
  status                              reservations_status @default(pending)
  pickup_deadline                     DateTime?           @db.DateTime(0)
  qr_code                             String?             @db.VarChar(500)
  note                                String?             @db.Text
  created_at                          DateTime            @default(now()) @db.DateTime(0)
  updated_at                          DateTime            @default(now()) @db.DateTime(0)
  books                               books               @relation(fields: [book_id], references: [book_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_reservation_book")
  users_reservations_buyer_idTousers  users               @relation("reservations_buyer_idTousers", fields: [buyer_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_reservation_buyer")
  smart_cabinets                      smart_cabinets?     @relation(fields: [cabinet_id], references: [cabinet_id], onUpdate: NoAction, map: "fk_reservation_cabinet")
  users_reservations_seller_idTousers users               @relation("reservations_seller_idTousers", fields: [seller_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_reservation_seller")

  @@index([book_id], map: "idx_book")
  @@index([buyer_id], map: "idx_buyer")
  @@index([cabinet_id], map: "idx_cabinet")
  @@index([seller_id], map: "idx_seller")
}

model shopping_cart {
  cart_id  Int      @id @default(autoincrement()) @db.UnsignedInt
  user_id  Int      @db.UnsignedInt
  book_id  Int      @db.UnsignedInt
