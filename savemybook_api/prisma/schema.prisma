  users        users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_session_user")

  @@index([user_id, revoked_at], map: "idx_session_user")
}

model ai_book_reviews {
  book_id     Int                    @id @db.UnsignedInt
  verdict     String                 @db.VarChar(10)
  reasons     String?                @db.Text
  categories  String?                @db.Text
  status      ai_book_reviews_status @default(pending)
  provider    String?                @db.VarChar(20)
  model       String?                @db.VarChar(80)
  created_at  DateTime               @db.DateTime(0)
  reviewed_by Int?                   @db.UnsignedInt
  reviewed_at DateTime?              @db.DateTime(0)
  books       books                  @relation(fields: [book_id], references: [book_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ai_review_book")

  @@index([status, created_at], map: "idx_ai_review_status")
}

model ai_chat_messages {
  message_id       Int                   @id @default(autoincrement()) @db.UnsignedInt
  session_id       Int                   @db.UnsignedInt
  role             ai_chat_messages_role
  content          String                @db.Text
  book_ids         String?               @db.VarChar(255)
  created_at       DateTime              @db.DateTime(0)
  ai_chat_sessions ai_chat_sessions      @relation(fields: [session_id], references: [session_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ai_chat_message_session")

  @@index([session_id, message_id], map: "idx_ai_chat_message_session")
}

model ai_chat_sessions {
  session_id       Int                     @id @default(autoincrement()) @db.UnsignedInt
  user_id          Int                     @db.UnsignedInt
  status           ai_chat_sessions_status @default(open)
  created_at       DateTime                @db.DateTime(0)
  updated_at       DateTime                @db.DateTime(0)
  ai_chat_messages ai_chat_messages[]
  users            users                   @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ai_chat_session_user")

  @@index([user_id, status], map: "idx_ai_chat_session_user")
}

model ai_consents {
  user_id    Int      @id @db.UnsignedInt
  granted    Boolean
  updated_at DateTime @db.DateTime(0)
  users      users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ai_consent_user")
}

model ai_recommendation_cache {
  user_id    Int      @id @db.UnsignedInt
  payload    String   @db.Text
  created_at DateTime @db.DateTime(0)
  users      users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ai_rec_user")
}

model ai_settings {
  id         Int      @id @db.UnsignedTinyInt
  config     String   @db.Text
  updated_by Int?     @db.UnsignedInt
  updated_at DateTime @db.DateTime(0)
}

model ai_support_messages {
  message_id          Int                      @id @default(autoincrement()) @db.UnsignedInt
  session_id          Int                      @db.UnsignedInt
  role                ai_support_messages_role
  content             String                   @db.Text
  created_at          DateTime                 @db.DateTime(0)
  ai_support_sessions ai_support_sessions      @relation(fields: [session_id], references: [session_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ai_message_session")

  @@index([session_id, message_id], map: "idx_ai_message_session")
}

model ai_support_sessions {
  session_id          Int                        @id @default(autoincrement()) @db.UnsignedInt
  user_id             Int                        @db.UnsignedInt
  status              ai_support_sessions_status @default(open)
  ticket_id           Int?                       @db.UnsignedInt
  created_at          DateTime                   @db.DateTime(0)
  updated_at          DateTime                   @db.DateTime(0)
  ai_support_messages ai_support_messages[]
  users               users                      @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ai_session_user")

  @@index([user_id, status], map: "idx_ai_session_user")
}

model ai_usage_logs {
  usage_id      BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  feature       String               @db.VarChar(30)
  provider      String               @db.VarChar(20)
  model         String               @db.VarChar(80)
  user_id       Int?                 @db.UnsignedInt
  input_tokens  Int                  @default(0) @db.UnsignedInt
  cached_tokens Int                  @default(0) @db.UnsignedInt
  output_tokens Int                  @default(0) @db.UnsignedInt
  search_calls  Int                  @default(0) @db.UnsignedInt
  cost_usd      Decimal              @default(0.000000) @db.Decimal(12, 6)
  latency_ms    Int                  @default(0) @db.UnsignedInt
  status        ai_usage_logs_status
  error_code    String?              @db.VarChar(60)
  error_detail  String?              @db.VarChar(400)
  created_at    DateTime             @db.DateTime(0)

  @@index([created_at], map: "idx_ai_usage_created")
  @@index([feature, created_at], map: "idx_ai_usage_feature")
  @@index([user_id, feature, created_at], map: "idx_ai_usage_user")
}

model auth_settings {
  id         Int      @id @db.UnsignedTinyInt
  config     String   @db.Text
  updated_by Int?     @db.UnsignedInt
  updated_at DateTime @db.DateTime(0)
}

model chat_mentions {
  message_id    Int           @db.UnsignedInt
  room_id       Int           @db.UnsignedInt
  user_id       Int           @db.UnsignedInt
  chat_messages chat_messages @relation(fields: [message_id], references: [message_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_mention_message")

  @@id([message_id, user_id])
  @@index([user_id, room_id, message_id], map: "idx_mention_user_room")
}

model oauth_results {
  code       String   @id @db.Char(32)
  payload    String   @db.Text
  created_at DateTime @db.DateTime(0)

  @@index([created_at], map: "idx_oauth_result_created")
}

model oauth_states {
  state      String            @id @db.Char(32)
  provider   String            @db.VarChar(20)
  mode       oauth_states_mode @default(login)
  user_id    Int?              @db.UnsignedInt
  created_at DateTime          @db.DateTime(0)

  @@index([created_at], map: "idx_oauth_state_created")
}

model user_identities {
  identity_id   Int                      @id @default(autoincrement()) @db.UnsignedInt
  user_id       Int                      @db.UnsignedInt
  provider      user_identities_provider
  subject       String
  email         String?                  @db.VarChar(255)
  phone         String?                  @db.VarChar(20)
  display_name  String?                  @db.VarChar(100)
  created_at    DateTime                 @db.DateTime(0)
  last_login_at DateTime?                @db.DateTime(0)
  users         users                    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_identity_user")

  @@unique([provider, subject], map: "uk_identity")
  @@index([user_id], map: "idx_identity_user")
}

