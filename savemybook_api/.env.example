# 複製成 .env 後填入實際值。只有前兩項是必填。

# 資料庫連線（密碼含 @ # / : 等字元時要做百分比編碼）
DATABASE_URL="mysql://帳號:密碼@127.0.0.1:3306/savemybook"

# JWT 簽章金鑰，至少 32 字元。可用 openssl rand -hex 32 產生
JWT_SECRET=""

# 使用者可見編號（交易編號、紀錄編號）的加密金鑰。設定後不可更換，否則既有編號全部改變；未設定時由 JWT_SECRET 衍生。
# 可用 openssl rand -hex 32 產生
PUBLIC_ID_SECRET=""

# ---- 以下選填 ----

PORT=3000

# 分享連結、QR Code 使用的網址前綴
PUBLIC_WEB_URL="https://api.savemybook.today"

# Google Books API 金鑰（ISBN 查詢，沒有也能用，只是額度較低）
GOOGLE_BOOKS_API_KEY=""

# AI 服務商 API 金鑰（AI 客服、上架輔助、推薦與上架審核）。只放在伺服器，不會寫入資料庫或回傳給 App。
# 未設定的服務商在後台顯示為未設定；三者皆未設定時 AI 功能不會啟用。服務商、模型與用量上限於後台「AI 設定」調整。
DEEPSEEK_API_KEY=""
GEMINI_API_KEY=""
# 設定後另啟用免費的 omni-moderation 上架內容預先篩檢
OPENAI_API_KEY=""

# Firebase 服務帳戶金鑰 JSON 的絕對路徑。沒設定時手機推播停用，其他功能照常
FCM_SERVICE_ACCOUNT_FILE="/etc/savemybook/firebase-service-account.json"
# PUSH_ENABLED=false

# 資料庫備份
# BACKUP_ENABLED=false
# BACKUP_DIR="/var/backups/savemybook"
# BACKUP_KEEP=14

# 反向代理設定。nginx 與 API 在同一台時維持預設 loopback 即可
# TRUST_PROXY=loopback
# CORS_ORIGINS="https://savemybook.today,https://www.savemybook.today"
# JWT_EXPIRES_IN=24h
